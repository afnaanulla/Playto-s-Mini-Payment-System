# Playto Payout Engine - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Django Settings
# ===========================================

# Set to False in production!
DEBUG=False

# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-production-secret-key-here

# Comma-separated list of allowed hosts
# For Railway: your-app.railway.app
# For local: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# Database Configuration
# ===========================================

# PostgreSQL (REQUIRED for production - SQLite won't work for concurrency)
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME

# For local development with Docker:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/playto

# For Railway (get from Railway dashboard):
# DATABASE_URL=postgres://user:password@host.railway.internal:5432/playto

# ===========================================
# Redis Configuration (for Celery)
# ===========================================

# For local development with Docker:
REDIS_URL=redis://localhost:6379/0

# For Railway (get from Railway dashboard):
# REDIS_URL=redis://host.railway.internal:6379

# ===========================================
# CORS Settings (Frontend URL)
# ===========================================

# Your frontend URL (Vercel, Netlify, etc.)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# For local development, you can allow all:
# (This is overridden in dev.py to True)

# ===========================================
# CSRF Trusted Origins
# ===========================================

CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# ===========================================
# Optional: Bank Simulation Delay
# ===========================================

# Delay in seconds to simulate bank API calls
# Set to 0 in production for instant processing
# Set to 0.5-2.0 for testing retry logic
BANK_SIMULATION_DELAY=0.5

# ===========================================
# Optional: Logging Level
# ===========================================

DJANGO_LOG_LEVEL=INFO
